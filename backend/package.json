{
    "name": "studiofy-backend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint src --ext .ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit generate && tsx src/db/migrate.ts",
        "db:seed": "tsx src/db/seed.ts",
        "db:rls": "tsx src/db/migrate.ts"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.39.3",
        "express": "^4.21.2",
        "helmet": "^8.0.0",
        "pg": "^8.13.3",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.13.4",
        "@types/pg": "^8.11.11",
        "drizzle-kit": "^0.30.4",
        "eslint": "^9.21.0",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3"
    }
}